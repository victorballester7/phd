<?xml version="1.0" encoding="utf-8"?>
<NEKTAR xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://www.nektar.info/nektar.xsd">

    <EXPANSIONS>      
      <E COMPOSITE="C[1]" NUMMODES="2" FIELDS="rho,rhou,rhov,E" TYPE="MODIFIED" />
      <E COMPOSITE="C[2]" NUMMODES="2" FIELDS="rho,rhou,rhov,E" TYPE="MODIFIED" />
    </EXPANSIONS>

    <CONDITIONS>
      <SOLVERINFO>
        <!--Implicit-->
        <!--
        <I PROPERTY="EQType"                VALUE="EulerImplicitCFE"    />
        <I PROPERTY="Projection"            VALUE="DisContinuous"       />
        <I PROPERTY="AdvectionType"         VALUE="WeakDG"              />
        <I PROPERTY="AdvectionAdvancement"  VALUE="Implicit"            />
        <I PROPERTY="TimeIntegrationMethod" VALUE="DIRKOrder2"          />
        <I PROPERTY="UpwindType"            VALUE="Roe"                 />
        <I PROPERTY="ProblemType"           VALUE="General"             />
        --> 
        <!--Explicit-->
        <I PROPERTY="EQType"                VALUE="EulerCFE"            />
        <I PROPERTY="Projection"            VALUE="DisContinuous"       />
        <I PROPERTY="AdvectionType"         VALUE="WeakDG"              />
        <I PROPERTY="AdvectionAdvancement"  VALUE="Explicit"            />
        <I PROPERTY="TimeIntegrationMethod" VALUE="RungeKutta2_SSP"     />
        <I PROPERTY="UpwindType"            VALUE="Roe"                 />
        <I PROPERTY="ProblemType"           VALUE="General"             />
      </SOLVERINFO>

      <PARAMETERS>
        <!-- Flow parameters -->
        <P> Gamma                 = 1.4                     </P>
        <P> Ma                    = 0.4                     </P>
        <P> GasConstant           = 1.0/(Gamma*Ma^2)        </P>
      
        <!-- Customized parameters -->
        <P> rhoInf                = 1.0                     </P>
        <P> TInf                  = 1.0                     </P>
        <P> UInf                  = 1.0                     </P>
        <P> pInf                  = rhoInf*GasConstant*TInf </P>
        <P> AoA                   = 0.0/180.0*PI            </P>
        <P> uInf                  = UInf*cos(AoA)           </P> 
        <P> vInf                  = UInf*sin(AoA)           </P>
      
        <!-- Number of steps-->
        <P> Timestep              = 2.0e-3                  </P> <!-- Not used but needed -->
        <P> NumSteps              = 5000                    </P> <!--2000-->
        <P> IO_InfoSteps          = 1                       </P>
        <P> IO_CheckSteps         = 200                     </P>              
      </PARAMETERS>

      <VARIABLES>
        <V ID="0"> rho  </V>
        <V ID="1"> rhou </V>
        <V ID="2"> rhov </V>
        <V ID="3"> E    </V>
      </VARIABLES>

      <BOUNDARYREGIONS>
        <B ID="0"> C[7] </B>  <!-- wall !-->
        <B ID="1"> C[5] </B>    <!-- outlet !-->
        <B ID="2"> C[3,6] </B>  <!-- ly sym !-->
        <B ID="3"> C[4] </B>    <!-- inlet !-->
      </BOUNDARYREGIONS>

      <BOUNDARYCONDITIONS>
        <REGION REF="0">
          <D VAR="rho"  USERDEFINEDTYPE="Wall" VALUE="0" />
          <D VAR="rhou" USERDEFINEDTYPE="Wall" VALUE="0" />
          <D VAR="rhov" USERDEFINEDTYPE="Wall" VALUE="0" />
          <D VAR="E"    USERDEFINEDTYPE="Wall" VALUE="0" />
        </REGION>
        <REGION REF="1">
          <D VAR="rho"    VALUE="rhoInf"     />
          <D VAR="rhou"   VALUE="rhoInf * uInf"   />
          <D VAR="rhov"   VALUE="rhoInf * vInf"   />
          <D VAR="E"      VALUE="pInf / (Gamma - 1) + 0.5 * rhoInf * (uInf * uInf + vInf * vInf)"/>
        </REGION>
        <REGION REF="2">
          <D VAR="rho"    VALUE="rhoInf"     />
          <D VAR="rhou"   VALUE="rhoInf * uInf"   />
          <D VAR="rhov"   VALUE="rhoInf * vInf"   />
          <D VAR="E"      VALUE="pInf / (Gamma - 1) + 0.5 * rhoInf * (uInf * uInf + vInf * vInf)"/>
        </REGION>
         <REGION REF="3">
          <D VAR="rho"    VALUE="rhoInf"     />
          <D VAR="rhou"   VALUE="rhoInf * uInf"   />
          <D VAR="rhov"   VALUE="rhoInf * vInf"   />
          <D VAR="E"      VALUE="pInf / (Gamma - 1) + 0.5 * rhoInf * (uInf * uInf + vInf * vInf)"/>
        </REGION>
      </BOUNDARYCONDITIONS>

      <FUNCTION NAME="InitialConditions">
        <!--<F VAR="rho,rhou,rhov,E"    FILE="1_dt5Em5_t005.fld"/>-->
        <!--<F VAR="rho,rhou,rhov,E"    FILE="2_dt1Em3_t1p05.fld"/>-->
        <F VAR="rho,rhou,rhov,E"    FILE="5_dt2Em3_t18p25.fld"/>

        <!--
        <E VAR="rho"    VALUE="rhoInf"     />
        <E VAR="rhou"   VALUE="rhoInf * uInf"   />
        <E VAR="rhov"   VALUE="rhoInf * vInf"   />
        <E VAR="E"      VALUE="pInf / (Gamma - 1) + 0.5 * rhoInf * (uInf * uInf + vInf * vInf)"/>
        --> 
      </FUNCTION>
    </CONDITIONS>

</NEKTAR>
