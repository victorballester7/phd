                                                     ) * (y< etaMax *  sqrt(1+x*C^2/Re_deltaStar_le) / C) +
                    (
                      (
                         a1_u*(etaMax)^1 +
                         a2_u*(etaMax)^2 + 
                         a3_u*(etaMax)^3 + 
                         a4_u*(etaMax)^4 + 
                         a5_u*(etaMax)^5 +
