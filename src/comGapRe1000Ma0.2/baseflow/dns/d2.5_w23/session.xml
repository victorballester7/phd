        <P> sponge_xmin                   = -100                              </P>
        <P> sponge_xmax                   = widthGap + 200                                 </P>
        <P> sponge_ymin                   = 50                                   </P>
        <P> sponge_ymax                   = 75                                   </P>
        <P> Amp                           = 50                                    </P>
        <P> sigma                         = Amp*uBulk/(sponge_ymax - sponge_ymin)                 </P>

