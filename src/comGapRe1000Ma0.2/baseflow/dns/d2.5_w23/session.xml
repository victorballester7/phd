    <!-- Sponge coeff: -->
    <FUNCTION NAME="InOutCoeff">
         <E VAR="rho"  VALUE="-sigma*(x>sponge_xmin)*(x<sponge_xmax)*((y>sponge_ymin)*(y<sponge_ymax)*(6*((y-sponge_ymin)/(sponge_ymax-sponge_ymin))^5 - 15*((y-sponge_ymin)/(sponge_ymin-sponge_ymax))^4 + 10*((y-sponge_ymin)/(sponge_ymax-sponge_ymin))^3) + (y>sponge_ymax))" />
         <E VAR="rhou"  VALUE="-sigma*(x>sponge_xmin)*(x<sponge_xmax)*((y>sponge_ymin)*(y<sponge_ymax)*(6*((y-sponge_ymin)/(sponge_ymax-sponge_ymin))^5 - 15*((y-sponge_ymin)/(sponge_ymin-sponge_ymax))^4 + 10*((y-sponge_ymin)/(sponge_ymax-sponge_ymin))^3) + (y>sponge_ymax))" />
         <E VAR="rhov"  VALUE="-sigma*(x>sponge_xmin)*(x<sponge_xmax)*((y>sponge_ymin)*(y<sponge_ymax)*(6*((y-sponge_ymin)/(sponge_ymax-sponge_ymin))^5 - 15*((y-sponge_ymin)/(sponge_ymin-sponge_ymax))^4 + 10*((y-sponge_ymin)/(sponge_ymax-sponge_ymin))^3) + (y>sponge_ymax))" />
         <E VAR="E"  VALUE="-sigma*(x>sponge_xmin)*(x<sponge_xmax)*((y>sponge_ymin)*(y<sponge_ymax)*(6*((y-sponge_ymin)/(sponge_ymax-sponge_ymin))^5 - 15*((y-sponge_ymin)/(sponge_ymin-sponge_ymax))^4 + 10*((y-sponge_ymin)/(sponge_ymax-sponge_ymin))^3) + (y>sponge_ymax))" />
