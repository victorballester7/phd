# --- Fonts & LaTeX ---
font.size: 8.7
text.usetex: True
font.family: serif
font.serif: Times New Roman, Times, Nimbus Roman, DejaVu Serif
axes.unicode_minus: False
text.latex.preamble: \usepackage{amsmath}\usepackage{newtxtext}\usepackage{newtxmath}

# --- Figure layout ---
figure.dpi: 300

# --- Axes ---
axes.labelsize: 8.7
axes.titlesize: 8.7
axes.linewidth: 1.0

# --- Grid ---
axes.grid: True
grid.alpha: 0.6
grid.linestyle: "-" 
grid.linewidth: 0.5

# --- Lines ---
lines.linewidth: 1.0
lines.markersize: 4.0
lines.markeredgewidth: 0.6

# --- Legend ---
legend.framealpha: 0.9
legend.fontsize: 8.7
legend.loc: best

# --- Ticks ---
xtick.direction: in
ytick.direction: in
xtick.labelsize: 8.7
ytick.labelsize: 8.7
xtick.major.width: 0.5
ytick.major.width: 0.5

# --- Savefig ---
savefig.bbox: tight
savefig.dpi: 300
